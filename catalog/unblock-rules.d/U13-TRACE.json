{
  "id": "U13-TRACE",
  "priority": 35,
  "family": "queue",
  "class": "fix-round",
  "cites": [
    "G13",
    "G12",
    "G21"
  ],
  "match": {
    "kind": "pr-ejected",
    "all": [
      ".batch_state == \"failed\"",
      ".owns_failure == true",
      ".ejected_on_head == true",
      "(.fixrounds | type) == \"number\" and (.fixround_max | type) == \"number\" and .fixrounds < .fixround_max",
      "(.fix_brief | type) == \"string\" and (.fix_brief | length) > 0",
      ".signal == \"trace\"",
      ".trace_own_new == true"
    ]
  },
  "judge": null,
  "action": {
    "name": "fix_round",
    "args": {
      "pr": ".pr",
      "head": ".head",
      "brief": ".fix_brief",
      "ticket": ".ticket"
    }
  },
  "key": [
    "repo",
    "pr",
    "head",
    "id"
  ],
  "note": "BH-8390 R-TRACE, real case (#8350). 'Tests cannot touch a real harness' HIT lines, and every HIT suite is a file this member ADDED: a fix round on its own new suite."
}
