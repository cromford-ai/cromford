{
  "id": "U13-OWNER",
  "priority": 37,
  "family": "queue",
  "class": "fix-round",
  "cites": [
    "G13",
    "G12",
    "G21"
  ],
  "match": {
    "kind": "pr-ejected",
    "all": [
      ".batch_state == \"failed\"",
      ".owns_failure == true",
      ".ejected_on_head == true",
      "(.fixrounds | type) == \"number\" and (.fixround_max | type) == \"number\" and .fixrounds < .fixround_max",
      "(.fix_brief | type) == \"string\" and (.fix_brief | length) > 0",
      ".signal == \"suite\""
    ]
  },
  "judge": null,
  "action": {
    "name": "fix_round",
    "args": {
      "pr": ".pr",
      "head": ".head",
      "brief": ".fix_brief",
      "ticket": ".ticket"
    }
  },
  "key": [
    "repo",
    "pr",
    "head",
    "id"
  ],
  "note": "BH-8390 R-INNOCENT, the owner half. A red batch with no single named culprit: this member owns a failing suite (the suite or a path its lines name is in its diff, or the suite's text names one of its files). One fix round with the failing suite lines as the brief."
}
