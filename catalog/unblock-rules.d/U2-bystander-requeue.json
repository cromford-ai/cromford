{
  "id": "U2-bystander-requeue",
  "priority": 20,
  "family": "queue",
  "class": "queue-requeue",
  "cites": ["G1", "G12"],
  "note": "A merge batch failed on one named culprit that is another PR. This PR is a bystander: its own CI is green, a MERGE verdict stands on its head, it is mergeable, and it was not put back on this head yet. Requeue it.",
  "match": {
    "kind": "pr-ejected",
    "all": [
      ".batch_state == \"failed\"",
      ".culprit != null and .culprit != .pr",
      ".own_ci == \"green\"",
      ".verdict_on_head | test(\"^MERGE\")",
      ".mergeable_state == \"clean\"",
      ".requeued_on_head == false"
    ]
  },
  "action": {
    "name": "requeue",
    "args": {"pr": ".pr", "head": ".head"}
  },
  "judge": null,
  "key": ["repo", "pr", "head"]
}
