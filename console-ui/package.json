{
  "name": "console-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mission Control — the web front-end for the cromford fleet control plane",
  "imports": {
    "#coord-writes": {
      "workerd": "./functions/_lib/coord-writes.gen.js",
      "default": "./tests/lib/coord-writes.node.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/coord-writes-build.mjs && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "drive:world": "node tests/drive/world-drive.mjs",
    "drive:keys": "node tests/drive/world-keys.mjs",
    "drive:density": "node tests/drive/density-drive.mjs",
    "drive:ideas": "node tests/drive/ideas-drive.mjs",
    "drive:outcomes": "node tests/drive/outcomes-drive.mjs",
    "drive:models": "node tests/drive/models-drive.mjs",
    "drive:staff": "node tests/drive/staff-drive.mjs",
    "drive:tap": "node tests/drive/tap-drive.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^10.76.2",
    "htm": "^3.1.1",
    "preact": "^10.26.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "preact-render-to-string": "^6.7.0",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
