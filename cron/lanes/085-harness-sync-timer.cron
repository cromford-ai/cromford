# harness-sync-timer (BH-7303): run bin/harness-sync.sh deploy when the last good sync is older than HARNESS_SYNC_PERIOD_MIN (15 min).
# Off: bin/harness-ctl.sh off harness-sync-timer. Dedupe: flock -n, it never waits on a running sync.
*/5 * * * * /root/harness/bin/harness-sync-timer.sh >/dev/null 2>&1
