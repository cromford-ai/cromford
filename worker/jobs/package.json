{
  "name": "harness-jobs",
  "private": true,
  "type": "module",
  "imports": {
    "#schema-sql": {
      "workerd": "./src/lib/schema-sql.workerd.js",
      "default": "./test/lib/schema-sql.node.js"
    },
    "#routes": {
      "workerd": "./src/routes.gen.js",
      "default": "./test/lib/routes.node.js"
    },
    "#core-registries": {
      "workerd": "./src/lib/core-registries.gen.js",
      "default": "./src/lib/core-registries.node.js"
    },
    "#retention-rules": {
      "workerd": "./src/retention-rules.gen.js",
      "default": "./src/lib/retention-rules.node.js"
    }
  },
  "description": "Coordination worker for the box fleet. One runtime dependency, @sentry/cloudflare (BH-5618), imported lazily and only when HARNESS_SENTRY_DSN is bound, so node --test still drives the worker directly without an install.",
  "scripts": {
    "test": "node --test test/*.test.js test/routes/*.test.js"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.6.0"
  }
}
