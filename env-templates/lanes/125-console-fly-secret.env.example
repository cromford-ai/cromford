# ---- Console worker Fly secrets (BH-7196) ----
# bin/fly-onboard.sh puts FLY_API_TOKEN_<P> on the console worker after an
# onboarding; bin/console-fly-secrets.sh puts any that are missing.
#   CONSOLE_CF_ACCOUNT_ID  the Cloudflare account id (32 hex) that owns the
#                          console worker. Unset = the step is skipped with
#                          one ALERTS line per onboarding. Required on the hub.
#   CONSOLE_WORKER_NAME    the console worker's name. Default harness-console.
#CONSOLE_CF_ACCOUNT_ID=
#CONSOLE_WORKER_NAME=harness-console
