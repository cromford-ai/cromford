# ---- sibling parts serialize (optional — ON is the default) ----
# Parts of one split ticket (TK-142.1, TK-142.2) whose pre-plan file lists share
# a path build one at a time, in n order; a part with no list waits for a
# sibling in flight. The fleet pool keeps the row queued and logs
# `SIBLING_SERIAL <K> waits for <S> on <file>` (bin/sibling-serial.sh).
#   1  = on (default)
#   0  = off: the pool spawns sibling parts as before.
# flags/sibling-serial-off (or the switch.sibling-serial-off row) is the same switch.
#SIBLING_SERIAL=1
# A lower queued sibling older than this many minutes holds nobody (0 = never holds).
#SIBLING_QUEUED_MAX_MIN=120
# Minutes a part waits before it is released with one warn alert (0 = no ceiling).
#SIBLING_SERIAL_MAX_MIN=360
# 0 = the pool waits behind an open sibling PR instead of building on its branch
# (stacked, BH-1174). 1 = it requeues the part once with that stack_base.
#SIBLING_STACK=1
# Days a parent's DECOMPOSED record makes its children parts (the parts map).
#SIBLING_PARTS_LOOKBACK_D=14
