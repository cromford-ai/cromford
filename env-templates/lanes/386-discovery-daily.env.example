# ---- discovery-daily (bin/discovery-daily.sh, BH-9795) ----
# Per-project daily lane: discovery sources become ai-build tickets. Set the
# per-project knobs as settings rows with bin/discovery-setup.sh, not here.
# The Sentry auth token the sentry source reads (hub env, the same token
# bin/sentry-triage.sh uses).
#SENTRY_API_TOKEN=
# SECRET (BH-9820): a project's own Sentry token, for a project in another
# Sentry org. It goes in env/<project>.env on the hub, never in global.env and
# never in a settings row. bin/discovery-daily.sh takes ONLY this name from
# that file (the file is not sourced). Unset: the sentry source uses
# SENTRY_API_TOKEN. Set the org with bin/discovery-setup.sh --sentry-org.
#DISCOVERY_SENTRY_TOKEN=
# Comma list of sources (part 1: sentry). Empty = off.
#DISCOVERY_SOURCES=
#DISCOVERY_SENTRY_ORG=
#DISCOVERY_SENTRY_PROJ=
#DISCOVERY_TARGET_REPO=
#DISCOVERY_MIN_EVENTS=
#DISCOVERY_LOOKBACK_H=
#DISCOVERY_TICKETS_DAY=
#DISCOVERY_MAX_CALLS_DAY=
#DISCOVERY_MAX_USD=
#DISCOVERY_MAX_ATTEMPTS=
#DISCOVERY_HOTFIX_24H=
#DISCOVERY_RAW_KEEP_D=
#DISCOVERY_MARKER_KEEP_D=
#DISCOVERY_RUN_TIMEOUT_S=
#DISCOVERY_STALE_PAD_S=
#DISCOVERY_CALL_TIMEOUT_S=
#DISCOVERY_DETAIL_MAX_BYTES=
#DISCOVERY_CAND_MATCH_CHARS=
#DISCOVERY_TICKET_TITLE_CHARS=
#DISCOVERY_ITEM_TITLE_CHARS=
