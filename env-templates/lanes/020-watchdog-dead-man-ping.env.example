# ---- watchdog dead-man ping (optional) ----
# Every watchdog caller reads the watchdog's WATCHDOG_SECRET from
# env/.watchdog-secret (mode 600, no trailing newline), then $WATCHDOG_SECRET,
# then HARNESS_SECRET above, so the ping keeps working before that file exists.
# It goes in an Authorization header, never in the URL. Provision it with:
#   printf '<secret>' > /root/harness/env/.watchdog-secret && chmod 600 /root/harness/env/.watchdog-secret
# WATCHDOG_URL=https://<your-watchdog>.workers.dev
# Empty means no watchdog calls, and one log line per lane per day saying so.
# This fleet's boxes get it seeded into env/global.env by harness-sync from catalog/fleet-watchdog.json.

