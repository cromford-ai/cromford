# /root/harness/env/<project>.env — one file per watched project. chmod 600. NEVER in git.
# Var names use a per-project PREFIX (e.g. PROJECT_1_, PROJECT_2_, PROJECT_3_, PROJECT_4_) — scripts
# discover them by suffix pattern, so keep the suffixes exactly as shown.

# ---- product board access (required) ----
# Internal API token the app accepts as the system actor, and the app's base URL.
# Suffix must be _INTERNAL_API_TOKEN and _API_BASE (or _APP_BASE).
<PREFIX>_INTERNAL_API_TOKEN=<token-the-app-recognizes>
<PREFIX>_API_BASE=https://<the-apps-prod-domain>

# ---- deploys (recommended) ----
# Vercel deploy hook (project-scoped, trigger-only URL): deploy-verify fires it
# when a merge produced no production deployment after 5 min.
DEPLOY_HOOK_URL=<vercel-deploy-hook-url>
# Protection bypass so preview QA can reach protected preview deployments
# (Vercel project → Deployment Protection → Protection Bypass for Automation).
VERCEL_AUTOMATION_BYPASS_SECRET=<32-char-secret>

# ---- migrations (if the app has the self-serve migration endpoint) ----
MIGRATION_TOKEN=<token>
# Hub migration lane (BH-8704, bin/migration-lane.sh). Only read when the
# settings row mc_migration_hold.apply_lane.<project> is `migration`. The lane
# also needs DATA_LANE_APP_BASE (the app base whose migrations/status proves
# each apply) and MIGRATION_TOKEN above.
# The project's own migration ledger CLI, run in a main tree:
MIGRATION_LANE_APPLY_CMD=node scripts/db/apply-sql.mjs
# Optional install step for that tree; runs when package-lock.json changes:
MIGRATION_LANE_SETUP_CMD=npm ci --ignore-scripts
# The production database the apply command gets as DATABASE_URL (env only):
MIGRATION_LANE_DATABASE_URL=<postgres-url>

# ---- authed preview QA (optional but recommended) ----
# A dedicated LOW-privilege test user in the app's Clerk instance. The QA stage
# mints a one-time sign-in token (skips instance MFA legitimately) and drives
# the app as this user. See docs/OPERATOR-SETUP.md §6.
QA_CLERK_SECRET_KEY=<clerk-secret-key-for-this-apps-instance>
QA_TEST_USER_ID=<user_...>
QA_TEST_EMAIL=qa-harness@<your-domain>
QA_TEST_PASSWORD=<generated>

# ---- preview E2E smoke path gate (optional) ----
# Which changed paths are worth pushing a branch and driving a browser for. The
# default below is the app/pages trees, components, public assets, stylesheets,
# middleware and the Next config — set this only where that list is wrong for
# the repo's layout.
# E2E_PATHS REPLACES the default list, it does not extend it: name every path
# you want matched. Comma or space separated. Blank (or whitespace only) means
# the default, never "match nothing".
#E2E_PATHS=src/app/** app/** pages/** components/** public/** *.css middleware.* next.config.*

# ---- post-merge production QA (bin/postmerge-qa.sh, SDLC 3b) ----
# Reuses the QA_* vars above; with either of QA_CLERK_SECRET_KEY /
# QA_TEST_USER_ID unset the stage runs, says no authed screen was covered, and
# drives nothing. All four settings below are OPTIONAL and shown at defaults.
# Privileged QA accounts are BANNED at rest in Clerk on purpose; the drive is
# routed through bin/qa-unbanned.sh, which lifts and RESTORES that ban itself —
# do not unban an account by hand to make this stage work.
#POSTMERGE_QA_USER_ID=<user_...>   # drive as someone other than QA_TEST_USER_ID
#POSTMERGE_QA_MAX=1                # builds driven per cron tick
#POSTMERGE_QA_LOOKBACK_HOURS=48    # how far back a merged build stays eligible
#POSTMERGE_QA_DEPLOY_MAX_HOURS=12  # hours after merge before an undeployed build is written NOT_COVERED_DEPLOY_TIMEOUT + one alert; 0 = never
#POSTMERGE_QA_AGENT=1              # 0 = deterministic drive only, no LLM lane
#POSTMERGE_QA_DISABLED=1           # off (same as flags/postmerge-qa-disabled)
# Check the account and routes without driving: bin/postmerge-qa.sh <project> --dry-run

# ---- post-rebase verify typecheck (bin/run-build.sh rebase stage) ----
# TSC_HEAP_MB — Node heap (MB) for run-build.sh's post-rebase verify typecheck.
# Unset = the largest --max-old-space-size the repo's .github/workflows declare,
# else 70% of RAM capped at 12288. project-5 needs 6144 (its CI sets it).
#TSC_HEAP_MB=6144

# ---- pool rebase (BH-486) ----
# Rebase this project's PRs on a pool machine instead of on the hub. Default OFF
# until it is proven; the hub keeps the lease, the approval rebind and the merge
# either way. Needs flags/fly-pool-app-<project> — set to 1 without it and the
# rebase runs on the hub and says so in logs/merge-conductor.log.
#REBASE_ON_POOL=0
# ---- box-side test selection (bin/run-build.sh HARNESS_SUITE_RUN) ----
#TEST_SELECT=1   # box-side test-impact selection; 0 = always the full suite; default on for GitHub-Issues repos with tests/impact-map.json or tests/static-guards.txt
